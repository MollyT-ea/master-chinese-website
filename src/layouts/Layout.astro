---
import '../styles/global.css';
const { title = "Master Chinese" } = Astro.props;
---
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · Master Chinese</title>
</head>
<body>
  <header class="site">
    <div class="wrap">
      <a href="/"><h1>🎙️Master Chinese</h1></a>
      <nav>
        <a href="/">Trang chủ</a>
        <a href="/#episodes">Episode</a>
      </nav>
    </div>
  </header>
  <main class="wrap">
    <slot />
  </main>
  <footer class="site">
    © 2026 Master Chinese Podcast · Nội dung học tiếng Trung miễn phí
  </footer>
</body>
</html>
